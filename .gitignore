# ==============================
# WasteSense AI — .gitignore
# ==============================

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
.Python

# Virtual Environment
venv/
env/
ENV/
.venv/

# Trained Model (large file — share separately)
trained_model/*.h5
trained_model/*.pkl
trained_model/*.pb

# Dataset (large — not tracked in Git)
dataset/

# TACO dataset
TACO/

# Environment Variables & Secrets
.env
*.env
config_local.py

# Database
*.db
*.sqlite3

# Logs
*.log
logs/

# OS Files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Jupyter Notebooks checkpoints
.ipynb_checkpoints/

# Distribution / Build
dist/
build/
*.egg-info/
*.egg

# Flask instance folder
instance/

# Uploaded images (runtime)
uploads/
static/uploads/

# Curl test file
curl
